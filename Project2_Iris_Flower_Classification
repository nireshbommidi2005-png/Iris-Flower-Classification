:{"type":"dataframe","variable_name":"sample","summary":"{\n  \"name\": \"sample\",\n  \"rows\": 1,\n  \"fields\": [\n    {\n      \"column\": \"sepal length (cm)\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": null,\n        \"min\": 5.1,\n        \"max\": 5.1,\n        \"num_unique_values\": 1,\n        \"samples\": [\n          5.1\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"sepal width (cm)\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": null,\n        \"min\": 3.5,\n        \"max\": 3.5,\n        \"num_unique_values\": 1,\n        \"samples\": [\n          3.5\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"petal length (cm)\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": null,\n        \"min\": 1.4,\n        \"max\": 1.4,\n        \"num_unique_values\": 1,\n        \"samples\": [\n          1.4\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"petal width (cm)\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": null,\n        \"min\": 0.2,\n        \"max\": 0.2,\n        \"num_unique_values\": 1,\n        \"samples\": [\n          0.2\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"}},"metadata":{}},{"output_type":"stream","name":"stdout","text":["Predicted flower species: setosa\n","\n","Class probabilities:\n","setosa: 98.08%\n","versicolor: 1.92%\n","virginica: 0.00%\n","\n","============================================================\n","PROJECT CONCLUSION\n","============================================================\n","1. The Iris dataset contains 150 records and 4 input features.\n","2. The three trained models were Logistic Regression, K-Nearest Neighbors, and Random Forest.\n","3. The model with the highest test accuracy was Logistic Regression, with 93.33% accuracy.\n","4. The confusion matrix shows 28 correct predictions and 2 errors on 30 test samples.\n","5. The results apply to this particular test split. Performance may vary on other data.\n","\n","PROJECT EXECUTION COMPLETED SUCCESSFULLY!\n"]}],"source":["\n","# ============================================================\n","# PROJECT 2: IRIS FLOWER CLASSIFICATION USING MACHINE LEARNING\n","# Student: Niresh\n","# Platform: Google Colab\n","# ============================================================\n","\n","# STEP 1: Import required libraries\n","import warnings\n","warnings.filterwarnings(\"ignore\")\n","\n","import pandas as pd\n","import numpy as np\n","import matplotlib.pyplot as plt\n","import seaborn as sns\n","\n","from sklearn.datasets import load_iris\n","from sklearn.model_selection import train_test_split\n","from sklearn.pipeline import make_pipeline\n","from sklearn.preprocessing import StandardScaler\n","from sklearn.impute import SimpleImputer\n","\n","from sklearn.linear_model import LogisticRegression\n","from sklearn.neighbors import KNeighborsClassifier\n","from sklearn.ensemble import RandomForestClassifier\n","\n","from sklearn.metrics import (\n","    accuracy_score,\n","    precision_score,\n","    recall_score,\n","    f1_score,\n","    classification_report,\n","    ConfusionMatrixDisplay,\n","    confusion_matrix\n",")\n","\n","print(\"=\" * 60)\n","print(\"IRIS FLOWER CLASSIFICATION PROJECT\")\n","print(\"=\" * 60)\n","\n","\n","# STEP 2: Load dataset\n","iris = load_iris(as_frame=True)\n","\n","X = iris.data.copy()\n","y = iris.target.copy()\n","\n","feature_names = list(X.columns)\n","target_names = iris.target_names\n","\n","print(\"\\nDataset loaded successfully!\")\n","print(\"Dataset shape:\", X.shape)\n","print(\"Number of features:\", X.shape[1])\n","print(\"Number of flower classes:\", len(target_names))\n","print(\"Flower classes:\", list(target_names))\n","\n","print(\"\\nFirst five records:\")\n","display(X.head())\n","\n","print(\"\\nDataset information:\")\n","display(X.describe())\n","\n","print(\"\\nMissing values in each feature:\")\n","print(X.isnull().sum())\n","\n","\n","# STEP 3: Preprocessing\n","# Fill any missing numeric values using the median.\n","# StandardScaler will be applied inside relevant model pipelines.\n","X = X.replace([np.inf, -np.inf], np.nan)\n","\n","X_train, X_test, y_train, y_test = train_test_split(\n","    X,\n","    y,\n","    test_size=0.20,\n","    random_state=42,\n","    stratify=y\n",")\n","\n","print(\"\\nPreprocessing completed!\")\n","print(\"Training records:\", len(X_train))\n","print(\"Testing records:\", len(X_test))\n","\n","# STEP 4: Define three ML models\n","models = {\n","    \"Logistic Regression\": make_pipeline(\n","        SimpleImputer(strategy=\"median\"),\n","        StandardScaler(),\n","        LogisticRegression(max_iter=1000, random_state=42)\n","    ),\n","\n","    \"K-Nearest Neighbors\": make_pipeline(\n","        SimpleImputer(strategy=\"median\"),\n","        StandardScaler(),\n","        KNeighborsClassifier(n_neighbors=5)\n","    ),\n","\n","    \"Random Forest\": make_pipeline(\n","        SimpleImputer(strategy=\"median\"),\n","        RandomForestClassifier(\n","            n_estimators=100,\n","            random_state=42\n","        )\n","    )\n","}\n","\n","\n","# STEP 5: Train and evaluate all models\n","results = []\n","trained_models = {}\n","predictions_by_model = {}\n","\n","for model_name, model in models.items():\n","\n","    # Train model\n","    model.fit(X_train, y_train)\n","\n","    # Predict test data\n","    y_pred = model.predict(X_test)\n","\n","    trained_models[model_name] = model\n","    predictions_by_model[model_name] = y_pred\n","\n","    # Calculate evaluation metrics\n","    results.append({\n","        \"Model\": model_name,\n","        \"Accuracy\": accuracy_score(y_test, y_pred),\n","        \"Precision\": precision_score(\n","            y_test, y_pred, average=\"macro\", zero_division=0\n","        ),\n","        \"Recall\": recall_score(\n","            y_test, y_pred, average=\"macro\", zero_division=0\n","        ),\n","        \"F1 Score\": f1_score(\n","            y_test, y_pred, average=\"macro\", zero_division=0\n","        )\n","    })\n","\n","results_df = pd.DataFrame(results)\n","results_df = results_df.sort_values(\n","    by=\"Accuracy\", ascending=False\n",").reset_index(drop=True)\n","\n","print(\"\\nMODEL PERFORMANCE COMPARISON\")\n","display(results_df.round(3))\n","\n","\n","# STEP 6: Visualize model accuracy\n","plt.figure(figsize=(9, 5))\n","sns.barplot(data=results_df, x=\"Model\", y=\"Accuracy\")\n","plt.title(\"Accuracy Comparison of ML Models\")\n","plt.xlabel(\"Machine Learning Model\")\n","plt.ylabel(\"Test Accuracy\")\n","plt.ylim(0, 1.05)\n","plt.xticks(rotation=15)\n","plt.tight_layout()\n","plt.show()\n","\n","\n","# STEP 7: Select the best model by test accuracy\n","best_name = results_df.iloc[0][\"Model\"]\n","best_model = trained_models[best_name]\n","best_pred = predictions_by_model[best_name]\n","\n","print(\"\\nBEST MODEL:\", best_name)\n","print(\n","    \"Test accuracy:\",\n","    round(accuracy_score(y_test, best_pred) * 100, 2),\n","    \"%\"\n",")\n","\n","print(\"\\nCLASSIFICATION REPORT\")\n","print(classification_report(\n","    y_test,\n","    best_pred,\n","    labels=np.arange(len(target_names)),\n","    target_names=target_names,\n","    zero_division=0\n","))\n","\n","\n","# STEP 8: Confusion matrix\n","cm = confusion_matrix(\n","    y_test,\n","    best_pred,\n","    labels=np.arange(len(target_names))\n",")\n","\n","plt.figure(figsize=(7, 5))\n","sns.heatmap(\n","    cm,\n","    annot=True,\n","    fmt=\"d\",\n","    cmap=\"Blues\",\n","    xticklabels=target_names,\n","    yticklabels=target_names\n",")\n","plt.title(\"Confusion Matrix - \" + best_name)\n","plt.xlabel(\"Predicted Flower\")\n","plt.ylabel(\"Actual Flower\")\n","plt.tight_layout()\n","plt.show()\n","\n","print(\"Correct predictions:\", int(np.trace(cm)))\n","print(\"Incorrect predictions:\", int(cm.sum() - np.trace(cm)))\n","print(\"Total test samples:\", int(cm.sum()))\n","\n","\n","# STEP 9: Predict a new sample\n","sample = pd.DataFrame(\n","    [[5.1, 3.5, 1.4, 0.2]],\n","    columns=feature_names\n",")\n","\n","predicted_class = best_model.predict(sample)[0]\n","predicted_flower = target_names[predicted_class]\n","\n","print(\"\\nSAMPLE FLOWER PREDICTION\")\n","print(\"Input measurements:\")\n","display(sample)\n","print(\"Predicted flower species:\", predicted_flower)\n","\n","# Optional: probabilities if supported by the model\n","if hasattr(best_model, \"predict_proba\"):\n","    probabilities = best_model.predict_proba(sample)[0]\n","    print(\"\\nClass probabilities:\")\n","    for flower, probability in zip(target_names, probabilities):\n","        print(f\"{flower}: {probability * 100:.2f}%\")\n","\n","\n","# STEP 10: Automatically generate a conclusion\n","best_row = results_df.iloc[0]\n","\n","print(\"\\n\" + \"=\" * 60)\n","print(\"PROJECT CONCLUSION\")\n","print(\"=\" * 60)\n","\n","print(\n","    \"1. The Iris dataset contains\",\n","    len(X), \"records and\", len(feature_names), \"input features.\"\n",")\n","print(\n","    \"2. The three trained models were Logistic Regression, \"\n","    \"K-Nearest Neighbors, and Random Forest.\"\n",")\n","print(\n","    f\"3. The model with the highest test accuracy was \"\n","    f\"{best_name}, with {best_row['Accuracy'] * 100:.2f}% accuracy.\"\n",")\n","print(\n","    f\"4. The confusion matrix shows {int(np.trace(cm))} correct \"\n","    f\"predictions and {int(cm.sum() - np.trace(cm))} errors \"\n","    f\"on {int(cm.sum())} test samples.\"\n",")\n","print(\n","    \"5. The results apply to this particular test split. \"\n","    \"Performance may vary on other data.\"\n",")\n","\n","print(\"\\nPROJECT EXECUTION COMPLETED SUCCESSFULLY!\")\n"]}]}